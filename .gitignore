.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Cache de Quarto: paquetes Typst descargados y available-fonts.json, que
# lista las fuentes de ESTA maquina. Se regenera solo al renderizar.
.quarto/
_freeze/

# Datos: nunca versionar. Sinteticos son reproducibles por seed;
# reales no pueden salir de la universidad (Ley 21.719).
data/raw/
data/bronze/
data/silver/
data/gold/
data/synthetic/
data/external/
data/results/
# Extractos institucionales y archivos de trabajo locales.
data/interim/
*.parquet
*.csv
!docs/**/*.csv
!documentacion/**/*.csv
!documentacion/assets/*.png

# Artefactos públicos revisados para ejecutar la app sin bases individuales.
# El CSV va explícito: la regla *.csv de arriba lo excluía, y sin él la app
# desplegada no puede mostrar el argumento central del proyecto.
!deploy/data/*.parquet
!deploy/data/*.csv
# Y las subcarpetas: `deploy/data/*.parquet` no alcanza a
# `deploy/data/institucional_agregado/*.parquet`, y quedaban fuera en silencio.
!deploy/data/**/*.parquet
!deploy/data/**/*.json
.streamlit/secrets.toml

.env
mlruns/
